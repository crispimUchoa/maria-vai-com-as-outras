[sub_resource type="Resource" id="Resource_wv4q4"]
script = ExtResource("7_ytvba")
id = "player"
text = "Oxii! A escola é pra cá não!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_2idmk"]
script = ExtResource("7_ytvba")
id = "player"
text = "Atrasada e errando caminho! Ô putariaaa!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_qhds1"]
size = Vector2(48, 26.08173)

[sub_resource type="Resource" id="Resource_ytvba"]
script = ExtResource("7_ytvba")
id = "player"
text = "Desgraça! Se eu for por aqui ele vai me pegar!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_en0nk"]
script = ExtResource("7_ytvba")
id = "player"
text = "Melhor correr pra casa!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_a7c13"]
script = ExtResource("7_ytvba")
id = "player"
text = "Não por aqui de novo de jeito nenhum!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_ytvba"]
size = Vector2(197, 74)

[sub_resource type="Resource" id="Resource_0gxrb"]
script = ExtResource("7_ytvba")
id = "renato_aragao"
text = "Ei, bichinha! Tu tem certeza que tu viu o bicho vindo por aqui? Porque o único rastro que a gente viu foi subindo pro meio dos mato ali perto da Zumira."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_ale6q"]
script = ExtResource("7_ytvba")
id = "player"
text = "Tenho sim! Ele me seguiu até perto de casa."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_1udov"]
script = ExtResource("7_ytvba")
id = "player"
text = "Você acredita em mim, né, professor?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_wkerr"]
script = ExtResource("7_ytvba")
id = "francisco_anysio"
text = "Acredito sim, minina. Esse diabo deve ter cobrido as pegadas."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_pm5ib"]
script = ExtResource("7_ytvba")
id = "renato_aragao"
text = "Não me venha com chorumelas! Aqui não é a escolinha da filha do Raimundo! Aqui é o mundo real! Onde já se viu animal esconder os rastros?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_g6i10"]
script = ExtResource("7_ytvba")
id = "renato_aragao"
text = "A gente ta falando de um puma ou raposa. Não do Curupira! Essa aí deve ter tido visage por causa do medo."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_dqk6t"]
script = ExtResource("7_ytvba")
id = "player"
text = "Eu sei o que eu vi!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

