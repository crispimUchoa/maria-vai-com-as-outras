[sub_resource type="RectangleShape2D" id="RectangleShape2D_jotlg"]
size = Vector2(40, 14)

[sub_resource type="Resource" id="Resource_xpv7c"]
script = ExtResource("9_hqfrt")
id = "player"
text = "Bom dia, seu Néisso!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_hqfrt"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Opa, Jovenzinha!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_ec5p2"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Que tragédia que aconteceu hoje, né?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_42k11"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Uma minina com tanta vida pela frente..."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_i3gmi"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Isso é um sinal de que nunca se deve ignorar o instinto."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_b6q21"]
script = ExtResource("9_hqfrt")
id = "player"
text = "Do que o senhor ta falando?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_vge41"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Nesses tempos do ano não é normal ventar gelado assim durante a noite."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_c44us"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Eu percebi desd'a hora que o sol se pôs. Aquele arrepio no espinhaço não era coisa de Deus. Fora a zuada."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_2hs5s"]
script = ExtResource("9_hqfrt")
id = "player"
text = "Que zuada? Do que o senhor ta falando?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_ibaas"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Isso não é hora pra ficar de fofoquinha não, o bar num trabaia sozin' não."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_7noax"]
script = ExtResource("9_hqfrt")
id = "player"
text = "Me conta! Por favooooor!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_5vcgp"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Faz o seguinte, Derruba esses 4 pé de pau que tão meio seco aqui perto do bar e eu te conto."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_mbh0w"]
script = ExtResource("9_hqfrt")
id = "player"
text = "Oxiii, como diabo eu vou fazer isso?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_pd53u"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Aí num é comigo."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_dnfb6"]
script = ExtResource("9_hqfrt")
id = "player"
text = "Pronto! Cabei, seu Neisso!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_tishs"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Ô garapa! Pois pronto, mia fia!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_sufq6"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Aproveite a disposição e arrume a ponte daqui. Depois da ponte eu conto tudo. Prometo!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_lg3jk"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Com a ponte quebrada, o povo tem que arrudear pela igreja pra chegar aqui."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_a1mr4"]
script = ExtResource("9_hqfrt")
id = "neisso"
text = "Aí o padre convence todo mundo a não beber. Esse padre ta do lado do Diabo querendo fechar meu bar!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="SpriteFrames" id="SpriteFrames_tishs"]
animations = [{
"frames": [{
"duration": 1.0,
"texture": ExtResource("10_lg3jk")
}, {
"duration": 1.0,
"texture": ExtResource("11_ai5bc")
}],
"loop": 1,
"name": &"default",
"speed": 5.0
}]

[sub_resource type="Resource" id="Resource_rcxc1"]
script = ExtResource("9_hqfrt")
id = "fazendeiro"
text = "Depois de um gole de pinga, sempre é bom descansar na sombra e tomar um vento."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_g20h6"]
script = ExtResource("9_hqfrt")
id = "fazendeiro"
text = "Refrasca a mente do caba antes do trabalho e do almoço. Eu queria trazer o Netin aqui."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_ai5bc"]
script = ExtResource("9_hqfrt")
id = "fazendeiro"
text = "Mas a Ocelina fica: \"Ain pain naum pode, o menino tem só 13 anos.\". Blá blá blá. Pense num mimimi. No meu tempo tinha isso não."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

