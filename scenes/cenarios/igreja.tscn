[sub_resource type="Resource" id="Resource_dxy02"]
script = ExtResource("4_ikkqh")
id = "player"
text = "RICARDO, SEU DESGRAÇADO!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_ikkqh"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Maria?? O que é isso? "
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_cbksu"]
script = ExtResource("4_ikkqh")
id = "player"
text = "Você vai pagar por todos os seus pecados!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_k2q7v"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Maria, solta esse machado e me explica o que ta acontecendo!d"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_ithvq"]
script = ExtResource("4_ikkqh")
id = "player"
text = "Não se faça de doido, Besta Fera! Eu vi o diário do vovô!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_daj1v"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "O diário do seu Chico? Meu Deus, eu posso explicar!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_a6jnv"]
script = ExtResource("4_ikkqh")
id = "player"
text = "Não tem o que explicar, eu sei o que você é!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_4n1mg"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Eu não sou! Eu não sou mais! Faz mais de 13 anos que eu não me transformo!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_u1tyd"]
script = ExtResource("4_ikkqh")
id = "player"
text = "Me explica isso agora!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_wmvra"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Eu era um licantropo! Mas não sou mais. Não depois do meu pecado mortal."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_m243g"]
script = ExtResource("4_ikkqh")
id = "player"
text = "Pecado mortal?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_vm278"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Eu tive um filho!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_o02cl"]
script = ExtResource("4_ikkqh")
id = "player"
text = "FILHO? E desde quando padre pode ter filho??"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_1qdth"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Nós nos amavamos. A Ocelina e eu nos am-"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_8shb6"]
script = ExtResource("4_ikkqh")
id = "player"
text = "A Ocelina? Mãe do Netin? Então, você passou a tocha pro seu filho?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_irg7f"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Não, não! Não tem nenhuma prova que foi ele!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_e0civ"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Ele pode ser curado! Seu avô teve fé em mim e por isso viramos amigos! Existe uma chance!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_2qiky"]
script = ExtResource("4_ikkqh")
id = "player"
text = "Ele tirou tudo de mim! Meu avô pode ter te perdoado, mas eu vou caçar seu filho. Porque é isso que fazemos com monstros"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_8cdej"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "NÃO! EU IMPLORO! EU NÃO VOU DEIXAR VOCÊ FAZER ISSO!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_qhds1"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "Maria? O que faz aqui hora dessa?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_jotlg"]
script = ExtResource("4_ikkqh")
id = "player"
text = "Padre, você viu ele passando aqui perto?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_dffqp"]
script = ExtResource("4_ikkqh")
id = "padre"
text = "O que? Não vi nem ouvi nada."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

