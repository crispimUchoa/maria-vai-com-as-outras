[sub_resource type="Resource" id="Resource_ww6jp"]
script = ExtResource("7_6wts5")
id = "player"
text = "PAI! CADÊ A MÃE!?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_oa4sc"]
script = ExtResource("7_6wts5")
id = "pai_maria"
text = "Deixe de zuada, minina! Onde é que tu tava até agora?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_ynh0k"]
script = ExtResource("7_6wts5")
id = "player"
text = "Pai, me escuta-"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_3q5d6"]
script = ExtResource("7_6wts5")
id = "pai_maria"
text = "Me escuta nada! Te mandei comprar um espoca bucho de manhã! E tu aparece de nooooite! Sem nem uma pitchulinha!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_gogah"]
script = ExtResource("7_6wts5")
id = "player"
text = "A mãe, pai! Onde a mãe tá?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_0ld4d"]
script = ExtResource("7_6wts5")
id = "pai_maria"
text = "Ela foi no Neísso. Comprar o espoca. Já que tu num quis nem fazer um suco. Ela teve que ir lá."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_wkge3"]
script = ExtResource("7_6wts5")
id = "pai_maria"
text = "Agora espere só ela chegar. Que você vai ver! E não quero você faça silêncio!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_voyhc"]
script = ExtResource("7_6wts5")
id = "player"
text = "Mas, pai..."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_yoln3"]
script = ExtResource("7_6wts5")
id = "pai_maria"
text = "Shhh! Quando sua mãe chegar, você vai ver!"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_r83si"]
script = ExtResource("7_6wts5")
id = "player"
text = "Pai, por que saiu cedo do velório da mãe?"
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

[sub_resource type="Resource" id="Resource_hdtws"]
script = ExtResource("7_6wts5")
id = "pai_maria"
text = "Amo demais sua mãe, não consigo suportar olhar pra'quele caixão... Deixe seu velho pai um pouco sozinho, vá buscar água nas cacimbas."
metadata/_custom_type_script = "uid://bhsfxfnqm52hj"

